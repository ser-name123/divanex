# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
# Public project URL. Safe to expose (it ships in the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Publishable/anon key. Also public. Row Level Security is enabled with no
# policies, so this key grants no table access on its own.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses RLS — every server-side query uses this, and nothing is
# persisted without it. Never prefix with NEXT_PUBLIC_.
# Dashboard -> Settings -> API Keys -> the "secret" key (starts with sb_secret_;
# older projects show it as service_role).
# Verify the whole chain afterwards with: npm run check-db
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (only needed to run `npm run setup-db`) ---
# SECRET. Dashboard -> Settings -> Database -> Connection string.
DATABASE_URL=

# --- Admin console auth ---
# Generate all three with: npm run gen-admin -- "your-password"
AUTH_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- Public site URL ---
# Where this deployment is reachable. Used for canonical links, the sitemap and
# the absolute og:image URL that chat apps and social networks fetch when
# someone shares a link. It overrides whatever is stored in site settings,
# because a stored value can name a domain that is not pointing here yet — and
# when that happens only the preview image fails, silently.
# On Vercel this is filled in automatically; set it explicitly once a custom
# domain is live.
NEXT_PUBLIC_SITE_URL=

# --- Origins allowed to send state-changing requests ---
# Comma-separated. The request host is always allowed, so this is only needed
# when the site is reached under more than one hostname (apex + www, a preview
# domain, a custom client domain). localhost is added automatically outside
# production. Anything not listed is rejected as CSRF.
ALLOWED_ORIGINS=https://divanex.vercel.app
