{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".build/types/**/*.ts",
    ".build/dev/types/**/*.ts",
    ".build2/types/**/*.ts",
    ".build2/dev/types/**/*.ts",
    ".build3/types/**/*.ts",
    ".build3/dev/types/**/*.ts",
    ".build_prod/types/**/*.ts",
    ".build_prod/dev/types/**/*.ts",
    ".build4/types/**/*.ts",
    ".build4/dev/types/**/*.ts",
    ".build5/types/**/*.ts",
    ".build5/dev/types/**/*.ts",
    ".build7/types/**/*.ts",
    ".build7/dev/types/**/*.ts",
    ".build8/types/**/*.ts",
    ".build8/dev/types/**/*.ts",
    ".buildfinal/types/**/*.ts",
    ".buildfinal/dev/types/**/*.ts",
    ".buildchat/types/**/*.ts",
    ".buildchat/dev/types/**/*.ts",
    ".buildforms/types/**/*.ts",
    ".buildforms/dev/types/**/*.ts",
    ".buildforms2/types/**/*.ts",
    ".buildforms2/dev/types/**/*.ts",
    ".buildv2/types/**/*.ts",
    ".buildv2/dev/types/**/*.ts",
    ".buildv3/types/**/*.ts",
    ".buildv3/dev/types/**/*.ts",
    ".buildv4/types/**/*.ts",
    ".buildv4/dev/types/**/*.ts",
    ".buildv5/types/**/*.ts",
    ".buildv5/dev/types/**/*.ts",
    ".buildv6/types/**/*.ts",
    ".buildv6/dev/types/**/*.ts",
    ".next-final/types/**/*.ts",
    ".next-final/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
