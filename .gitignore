# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/out/
# Build output, under any NEXT_DIST_DIR name. The globs are deliberately wide:
# these directories hold the fetch cache, which carries Supabase project refs
# and response cookies, and a directory named just outside a narrower pattern
# has already turned up untracked twice (.next-c1, then .next_dev).
/.next*/
/.build*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local browser profiles
.edge*
